# Copy this file to .env and fill in real values before running docker compose up

SESSION_SECRET=change-this-to-a-long-random-string

# First-run default login (only used the very first time, to seed the users table)
DEFAULT_USERNAME=megan
DEFAULT_PASSWORD=change-this-before-first-run

PORT=3000

# --- QuickBooks Online API ---
# From your Intuit Developer app (see README for setup steps)
QB_CLIENT_ID=
QB_CLIENT_SECRET=
# Must exactly match the Redirect URI registered in your Intuit app
QB_REDIRECT_URI=https://estimate.thenextwaveit.com/api/qb/callback
# 'production' once your app is live, 'sandbox' only if testing against a QuickBooks sandbox company
QB_ENVIRONMENT=production
